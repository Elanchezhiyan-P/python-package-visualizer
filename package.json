{
  "name": "python-package-visualizer-community",
  "displayName": "Python Package Visualizer (Community)",
  "description": "Community-maintained fork to visualize, manage and audit Python workspace dependencies — version checks, CVE badges, unused package detection, dependency graph, uv migration, and one-click updates.",
  "version": "3.3.1",
  "icon": "media/icon.png",
  "publisher": "FaberVi",
  "license": "MIT",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "python",
    "pip",
    "uv",
    "pypi",
    "dependencies",
    "packages",
    "visualizer"
  ],
  "author": {
    "name": "Vincenzo Fabiano",
    "url": "https://github.com/FaberVi"
  },
  "homepage": "https://github.com/FaberVi/python-package-visualizer",
  "bugs": {
    "url": "https://github.com/FaberVi/python-package-visualizer/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FaberVi/python-package-visualizer"
  },
  "activationEvents": [
    "onLanguage:python",
    "workspaceContains:**/requirements.txt",
    "workspaceContains:**/pyproject.toml",
    "workspaceContains:**/setup.py"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pythonPackageVisualizer",
          "title": "Python Packages",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "pythonPackageVisualizer": [
        {
          "type": "webview",
          "id": "pythonPackageVisualizer.sidebar",
          "name": "Package Visualizer",
          "icon": "media/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "extension.showPackageVisualizer",
        "title": "Show Package Visualizer",
        "category": "Python Packages",
        "icon": "$(package)"
      },
      {
        "command": "extension.openPackageVisualizer",
        "title": "Open Package Visualizer",
        "category": "Python Packages"
      },
      {
        "command": "extension.checkPackageUpdates",
        "title": "Check Package Updates",
        "category": "Python Packages",
        "icon": "$(refresh)"
      },
      {
        "command": "extension.updatePackage",
        "title": "Update Package",
        "category": "Python Packages"
      },
      {
        "command": "extension.rollbackPackage",
        "title": "Rollback Package",
        "category": "Python Packages"
      },
      {
        "command": "extension.selectManualRequirements",
        "title": "Select requirements.txt Manually...",
        "category": "Python Packages"
      },
      {
        "command": "extension.clearManualRequirements",
        "title": "Clear Manually Selected requirements.txt",
        "category": "Python Packages"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "resourceFilename == requirements.txt || resourceFilename == pyproject.toml || resourceFilename == setup.py",
          "command": "extension.showPackageVisualizer",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "when": "resourceFilename == requirements.txt || resourceFilename == pyproject.toml || resourceFilename == setup.py",
          "command": "extension.checkPackageUpdates",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "extension.showPackageVisualizer"
        },
        {
          "command": "extension.openPackageVisualizer"
        },
        {
          "command": "extension.checkPackageUpdates"
        },
        {
          "command": "extension.updatePackage",
          "when": "false"
        },
        {
          "command": "extension.rollbackPackage",
          "when": "false"
        },
        {
          "command": "extension.selectManualRequirements"
        },
        {
          "command": "extension.clearManualRequirements"
        }
      ]
    },
    "configuration": {
      "title": "Python Package Visualizer",
      "properties": {
        "pythonPackageVisualizer.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Override Python interpreter path (leave empty to auto-detect from ms-python extension or PATH)"
        },
        "pythonPackageVisualizer.cacheExpiryMinutes": {
          "type": "number",
          "default": 60,
          "minimum": 1,
          "maximum": 1440,
          "description": "Minutes before cached PyPI data is considered stale and re-fetched"
        },
        "pythonPackageVisualizer.autoCheckOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "Automatically check for updates when a Python workspace opens"
        },
        "pythonPackageVisualizer.notifyOnOutdated": {
          "type": "boolean",
          "default": true,
          "description": "Show notification when outdated packages are found during auto-check"
        },
        "pythonPackageVisualizer.updateCheckSchedule": {
          "type": "string",
          "enum": [
            "off",
            "daily",
            "weekly",
            "monthly"
          ],
          "default": "off",
          "description": "Schedule periodic checks for outdated packages."
        },
        "pythonPackageVisualizer.showImportCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show import annotations (package status badges) above each import line."
        },
        "pythonPackageVisualizer.showImportHover": {
          "type": "boolean",
          "default": true,
          "description": "Show package info when hovering over import statements."
        },
        "pythonPackageVisualizer.showFunctionMetrics": {
          "type": "boolean",
          "default": true,
          "description": "Show function metrics (line count, references, complexity) above each function definition."
        },
        "pythonPackageVisualizer.showComplexityWarnings": {
          "type": "boolean",
          "default": true,
          "description": "Warn when function cyclomatic complexity is high (>= 10)."
        },
        "pythonPackageVisualizer.showTypeHintCoverage": {
          "type": "boolean",
          "default": true,
          "description": "Warn when function parameters or return value lack type hints."
        },
        "pythonPackageVisualizer.showDocstringWarnings": {
          "type": "boolean",
          "default": true,
          "description": "Warn when functions are missing a docstring."
        },
        "pythonPackageVisualizer.showMethodCallHover": {
          "type": "boolean",
          "default": true,
          "description": "Show package info and API cost estimates when hovering over method calls (e.g., ChatGroq, fitz.open)."
        },
        "pythonPackageVisualizer.language": {
          "type": "string",
          "enum": [
            "en",
            "it"
          ],
          "default": "en",
          "enumDescriptions": [
            "English",
            "Italiano"
          ],
          "description": "UI language for the Package Visualizer webview and sidebar."
        },
        "pythonPackageVisualizer.cursorAiAnalysis": {
          "type": "boolean",
          "default": true,
          "description": "Show the AI review button for unused packages in Cursor. Analysis runs only when you click that button — never automatically."
        },
        "pythonPackageVisualizer.cursorAiUseAutoModel": {
          "type": "boolean",
          "default": true,
          "description": "When opening Cursor Agent for unused-package analysis, use the Auto model (Cursor model id: default)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node ./out-test/test/runTests.js",
    "test:unit": "node -r ./test/helpers/registerVscodeMock.cjs ./out-test/test/runUnitTests.js",
    "test:grep": "node -r ./test/helpers/registerVscodeMock.cjs ./out-test/test/runGrepTests.js",
    "test:coverage": "npm run pretest && c8 --config c8.json node -r ./test/helpers/registerVscodeMock.cjs ./out-test/test/runUnitTests.js",
    "test:coverage:check": "npm run pretest && c8 --config c8.json node -r ./test/helpers/registerVscodeMock.cjs ./out-test/test/runUnitTests.js",
    "lint": "eslint src",
    "package": "vsce package",
    "screenshots": "python scripts/screenshots/capture.py"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.105.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "glob": "^13.0.6",
    "mocha": "^12.0.0",
    "typescript": "^6.0.3"
  }
}
